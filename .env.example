# ==============================================================================
# 1. APPLICATION & SERVER CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=3001
# Frontend client URL (Vite dev server default in this project is port 3000)
CLIENT_URL=http://localhost:3000
# File upload storage directory
UPLOAD_DIR=uploads

# ==============================================================================
# 2. POSTGRESQL DATABASE
# ==============================================================================
DATABASE_URL=postgresql://devflow:devflow@localhost:5432/devflow?schema=public
# Docker Compose Postgres container credentials
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow_secure_password

# ==============================================================================
# 3. AUTHENTICATION & ENCRYPTION SECRETS
# ==============================================================================
# JWT Access Token signing secret (minimum 32 characters, JWT_ACCESS_SECRET supported as alias)
JWT_SECRET=devflow_jwt_auth_access_token_signing_key_32_characters
# AES-256-GCM token encryption key (must be exactly 64 hexadecimal characters / 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Refresh Cookie SameSite policy: 'lax', 'strict', or 'none'
REFRESH_COOKIE_SAME_SITE=lax
# Note: Refresh tokens are opaque DB-backed tokens hashed with SHA-256; no JWT_REFRESH_SECRET is needed.

# ==============================================================================
# 4. GOOGLE OAUTH 2.0
# ==============================================================================
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/oauth/google/callback

# ==============================================================================
# 5. FACEBOOK / META OAUTH 2.0
# ==============================================================================
# Obtain from Meta for Developers (developers.facebook.com) > App Dashboard
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/auth/oauth/facebook/callback
# Meta Graph API version (defaults to v27.0)
FACEBOOK_GRAPH_API_VERSION=v27.0

# ==============================================================================
# 6. GITHUB OAUTH 2.0
# ==============================================================================
# Obtain from GitHub Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ==============================================================================
# 7. AI & GEMINI CONFIGURATION
# ==============================================================================
# 'mock' for local development without API key; 'gemini' for real LLM integration
AI_PROVIDER=mock
# Gemini API Key from Google AI Studio (required only when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key
# Gemini Model identifier: 'gemini-3.5-flash' (recommended default), 'gemini-3.1-flash-lite', or 'gemini-1.5-pro'
AI_MODEL=gemini-3.5-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# ==============================================================================
# 8. PAYPAL SANDBOX CONFIGURATION
# ==============================================================================
# Obtain from PayPal Developer Dashboard (developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id

# ==============================================================================
# 9. EMAIL / SMTP CONFIGURATION
# ==============================================================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=smtp_username
EMAIL_PASSWORD=smtp_password
EMAIL_FROM=noreply@devflow.dev
