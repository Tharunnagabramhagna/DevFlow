# Environment & Server
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://devflow:devflow@localhost:5432/devflow
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow_secure_password

# Authentication & Security (AES-256-GCM 32-byte hex key, JWT 32+ char secret)
JWT_SECRET=devflow_jwt_secure_super_secret_key_minimum_32_characters
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
REFRESH_COOKIE_SAME_SITE=lax
UPLOAD_DIR=uploads

# GitHub OAuth 2.0 Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# AI Provider Configuration (mock for development/testing, gemini for production)
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-2.0-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# PayPal REST API Integration (Sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id

# Email / SMTP Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=smtp_username
EMAIL_PASSWORD=smtp_password
EMAIL_FROM=noreply@devflow.dev
