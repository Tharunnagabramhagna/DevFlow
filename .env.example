# ==============================================================================
# 1. APPLICATION & SERVER CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=3001
# Optional reverse-proxy / HTTPS tunnel trust policy: 'false' (default), 'loopback', 'linklocal', 'uniquelocal', or hop count '1'-'5'
# Set to 'loopback' or '1' only when running behind a local HTTPS webhook tunnel or single reverse proxy; never trusts arbitrary forwarded headers
TRUST_PROXY=false
# Frontend client URL (Vite dev server default in this project is port 3000)
CLIENT_URL=http://localhost:3000
# File upload storage directory
UPLOAD_DIR=uploads

# ==============================================================================
# 2. POSTGRESQL DATABASE
# ==============================================================================
# Main development database connection (credentials must match actual Docker PostgreSQL configuration)
DATABASE_URL=postgresql://devflow:devflow_secure_password@localhost:5432/devflow?schema=public
# Dedicated test database (required for running automated tests; must target devflow_test)
TEST_DATABASE_URL=postgresql://devflow:devflow_secure_password@localhost:5432/devflow_test?schema=public
# Docker Compose Postgres container credentials (must match credentials in DATABASE_URL and TEST_DATABASE_URL)
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow_secure_password

# ==============================================================================
# 3. AUTHENTICATION & ENCRYPTION SECRETS
# ==============================================================================
# JWT Access Token signing secret (minimum 32 characters, JWT_ACCESS_SECRET supported as alias)
JWT_SECRET=devflow_jwt_auth_access_token_signing_key_32_characters
# AES-256-GCM token encryption key (must be exactly 64 hexadecimal characters / 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Refresh Cookie SameSite policy: 'lax', 'strict', or 'none'
REFRESH_COOKIE_SAME_SITE=lax
# Note: Refresh tokens are opaque DB-backed tokens hashed with SHA-256; no JWT_REFRESH_SECRET is needed.

# ==============================================================================
# 4. GOOGLE OAUTH 2.0
# ==============================================================================
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/oauth/google/callback

# ==============================================================================
# 5. FACEBOOK / META OAUTH 2.0
# ==============================================================================
# Obtain from Meta for Developers (developers.facebook.com) > App Dashboard
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/auth/oauth/facebook/callback
# Meta Graph API version (defaults to v27.0)
FACEBOOK_GRAPH_API_VERSION=v27.0

# ==============================================================================
# 6. GITHUB OAUTH 2.0 (LOGIN IDENTITY)
# ==============================================================================
# Obtain from GitHub Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ==============================================================================
# 6B. GITHUB APP (REPOSITORY ACCESS - DevFlowWebsite)
# ==============================================================================
# Obtain from GitHub Settings > Developer settings > GitHub Apps > DevFlowWebsite
# Leave blank if GitHub App repository integration is not configured yet
GITHUB_APP_ID=5728161
GITHUB_APP_SLUG=devflowwebsite
# PEM private key with literal \n newline escapes (keep empty in repo; set only in local/server .env)
GITHUB_APP_PRIVATE_KEY=
# Optional base64-encoded PEM private key alternative to GITHUB_APP_PRIVATE_KEY
GITHUB_APP_PRIVATE_KEY_BASE64=
# Numeric GitHub user ID allowed to complete Setup URL installation in single-account dev mode
GITHUB_APP_ALLOWED_ACCOUNT_ID=your_numeric_github_account_id
# Webhook HMAC secret (configured in GitHub App settings; falls back to GITHUB_WEBHOOK_SECRET if unset)
GITHUB_APP_WEBHOOK_SECRET=your_github_app_webhook_secret
# Public HTTPS webhook URL (use an HTTPS tunnel such as ngrok or cloudflared when testing locally)
GITHUB_APP_WEBHOOK_URL=https://your-https-tunnel.example.com/api/github/webhooks
# Post-installation Setup URL configured in the GitHub App settings
GITHUB_APP_SETUP_URL=http://localhost:3001/api/github/app/setup

# ==============================================================================
# 7. AI & GEMINI CONFIGURATION
# ==============================================================================
# 'mock' for local development without API key; 'gemini' for real LLM integration
AI_PROVIDER=mock
# Gemini API Key from Google AI Studio (required only when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key
# Gemini Model identifier: 'gemini-3.5-flash' (recommended default), 'gemini-3.1-flash-lite', or 'gemini-1.5-pro'
AI_MODEL=gemini-3.5-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# ==============================================================================
# 8. PAYPAL SANDBOX CONFIGURATION
# ==============================================================================
# Obtain from PayPal Developer Dashboard (developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id

# ==============================================================================
# 9. EMAIL / SMTP CONFIGURATION
# ==============================================================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=smtp_username
EMAIL_PASSWORD=smtp_password
EMAIL_FROM=noreply@devflow.dev

# ==============================================================================
# 10. FRONTEND CLIENT (VERCEL / PRODUCTION)
# ==============================================================================
# Deployed HTTPS backend URL for production frontend builds (leave empty in local dev)
VITE_API_BASE_URL=https://your-backend-api.example.com
