# ==============================================================================
# DEVFLOW FRONTEND — VERCEL & PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# The HTTPS base URL of your deployed DevFlow backend API.
# In local development, leave this empty to use the Vite local proxy (http://localhost:3001).
# Example for production on Vercel:
# VITE_API_BASE_URL=https://api.devflow.io
# or
# VITE_API_BASE_URL=https://devflow-backend.onrender.com
VITE_API_BASE_URL=https://your-backend-api.example.com

# SECURITY NOTE:
# Never put database credentials, JWT secrets, PayPal secrets, or private keys
# in Vite environment variables. Any variable prefixed with VITE_ is compiled
# into the public browser bundle. Backend credentials must stay on the backend server.
