{
  "name": "devflow",
  "version": "0.1.0",
  "private": true,
  "description": "DevFlow — AI-powered milestone intelligence and payment orchestration",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "start:backend": "npm run start --prefix backend",
    "dev:all": "node scripts/dev.mjs",
    "db:up": "docker compose up -d postgres",
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema database/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema database/prisma/schema.prisma",
    "db:test": "npm --prefix backend exec -- tsx database/prisma/validate.ts"
  },
  "prisma": {
    "seed": "tsx database/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.23.15"
  }
}
